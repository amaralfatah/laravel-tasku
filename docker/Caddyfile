{
	frankenphp
	# Render terminates TLS at its edge, so the container serves plain HTTP.
	auto_https off
	admin off
	log {
		format json
	}
}

:{$PORT:10000} {
	root /app/public
	encode zstd br gzip

	# Hashed Vite output can be cached forever; nothing else here can.
	@immutable path /build/assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_server {
		index index.php
	}
}
