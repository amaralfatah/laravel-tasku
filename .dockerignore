# Dependencies and build output are produced inside the image.
/node_modules
/vendor
/public/build
/public/hot
/public/storage
/bootstrap/cache/*.php
/bootstrap/ssr
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# Local state that must never leak into a deployed image.
.env
.env.*
!.env.example
/storage/app/private
/storage/app/public
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/testing
/storage/framework/views
/storage/logs
/storage/pail
/storage/*.key
/database/database.sqlite

# Tooling and metadata that the runtime does not need.
.git
.github
.ai
.agents
.claude
.codex
.neon
/tests
/docs
.editorconfig
.gitattributes
.gitignore
.mcp.json
.phpunit.cache
.phpunit.result.cache
.prettierignore
.prettierrc
AGENTS.md
CLAUDE.md
DESIGN.md
boost.json
eslint.config.js
opencode.json
phpstan.neon
phpunit.xml
pint.json
skills-lock.json
ContohLaporan.xlsx
